# Supabase 프로젝트 설정 > API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# 서버 전용 Supabase 키 (NEXT_PUBLIC_ 금지). 같은 화면의 service_role 키
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API 키 (서버에서만 사용, 브라우저로 노출되지 않음)
ANTHROPIC_API_KEY=sk-ant-...

# 사용할 Claude 모델. 기본은 비용이 낮은 Haiku. 품질을 높이려면 claude-opus-5-5 (비용 약 40배).
CLAUDE_MODEL=claude-haiku-5-5

# Google 로그인 버튼 표시 (Supabase 에 Google 제공자를 설정한 뒤 on)
NEXT_PUBLIC_GOOGLE_LOGIN=off
